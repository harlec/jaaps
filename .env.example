# ─────────────────────────────────────────────────────────────
# JAAP – Plantilla de variables de entorno
# Copia este archivo como .env y rellena los valores reales:
#   cp .env.example .env
# El archivo .env está en .gitignore y NUNCA se sube a Git.
# ─────────────────────────────────────────────────────────────

# ── Base de datos ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jaap
DB_USER=jaap_user
DB_PASS=CAMBIA_ESTA_CONTRASENA

# ── API migo.pe (https://migo.pe → Mi cuenta → Tokens) ───────
MIGO_API_TOKEN=PEGA_TU_TOKEN_AQUI

# ── URL base de la aplicación (sin barra al final) ───────────
APP_URL=http://localhost/jaaps
