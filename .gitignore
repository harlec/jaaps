# ── Credenciales y configuración local ──────────────────────
.env

# ── Scripts de mantenimiento temporal (nunca a Git) ──────────
reset_admin.php

# ── Dependencias / paquetes ──────────────────────────────────
# vendor/ SÍ se versiona a propósito: el servidor de producción no tiene
# Composer, así que PhpSpreadsheet (usado en reportes/abonados_excel.php)
# se sube ya generado. No ejecutar "composer install" sin revisar esto.
node_modules/

# ── Archivos subidos por usuarios ────────────────────────────
uploads/
importar/uploads/

# ── Caché y logs ─────────────────────────────────────────────
*.log
*.cache

# ── Sistema operativo ────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDEs ─────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
